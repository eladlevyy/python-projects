{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/components": ["./src/components"],
      "@/lib": ["./src/lib"],
      "@/styles": ["./src/styles"],
      "@/utils": ["./src/utils"],
      "@/hooks": ["./src/hooks"],
      "@/types": ["./src/types"],
      "@mind-vitality/types": ["../../packages/types/src"],
      "@mind-vitality/ui": ["../../packages/ui/src"],
      "@mind-vitality/utils": ["../../packages/utils/src"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
